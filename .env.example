# Required
OPENAI_API_KEY=sk-your-key
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536
IMAGE_QUALITY=medium
EVAL_MODEL=gpt-5.6-luna

# Adaptive prompt A/B policy
EXPERIMENT_EPSILON=0.15

# Optional AWS S3 adapter (not required for local MVP)
AWS_REGION=ap-northeast-2
S3_BUCKET=
# AWS_ACCESS_KEY_ID=   # prefer IAM role in AWS
# AWS_SECRET_ACCESS_KEY=

EVAL_CASE_LIMIT=1
EVAL_PROMPT_VERSIONS=P0,P1,P2,P3
