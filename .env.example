# Optional for AI features; not needed for the sample demo.
OPENAI_API_KEY=sk-your-key
# Vercel requires live explicitly. Set demo for no paid calls.
AI_MODE=demo
# Set only in Vercel Production; use that deployment's URL in Preview if needed.
# APP_URL=https://chgumi.vercel.app
# Both values select Supabase automatically. Leave both unset for local file storage.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_your_key
# Text coaching: Responses API + function calling + structured outputs.
COACH_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536
IMAGE_QUALITY=medium
EVAL_MODEL=gpt-5.6-luna

# Adaptive prompt A/B policy
EXPERIMENT_EPSILON=0.15

# Optional AWS S3 adapter (not required for local MVP)
AWS_REGION=ap-northeast-2


EVAL_CASE_LIMIT=1
EVAL_PROMPT_VERSIONS=CONTROL,PRESERVE_FIRST,STYLE_FIRST

# Mount a persistent disk here in production (single server).
# EXPERIMENT_DATA_DIR=/persistent/chugumi/experiments

# Record-only quality evaluation after generation; false disables this extra API call.
GENERATION_EVALUATION_ENABLED=true
